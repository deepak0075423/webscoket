# ── Required ──────────────────────────────────────────────────────────────────

# Redis connection (same instance used by the Chat Service)
REDIS_URL=redis://localhost:6379

# URL of the school-backend API — used to call /internal/* on socket connect
# (the backend's own port, NOT this gateway's)
CHAT_SERVICE_URL=http://localhost:5000

# Pre-shared secret for the /internal/* REST endpoints
# Must match INTERNAL_SECRET in the Chat Service's .env
INTERNAL_SECRET=change-me-to-a-long-random-string

# Must match JWT_SECRET in school-backend/.env — the web and mobile apps
# authenticate their sockets with the API's JWT. If this is missing or wrong,
# every socket handshake is rejected ("Unauthenticated") and live chat plus
# live notifications silently stop working.
JWT_SECRET=change-me-to-match-the-backend

# Must match SESSION_SECRET in the Chat Service's .env
# Both services share the same Redis session store, so the secret must be identical
SESSION_SECRET=change-me-to-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Port this gateway listens on (default: 4000)
PORT=4000

# Comma-separated list of allowed CORS origins (leave blank to allow all — dev only)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
